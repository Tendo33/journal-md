{
  "name": "journal-md",
  "version": "1.1.1",
  "private": true,
  "description": "Journal to Markdown — browser extension that saves open-access journal articles as clean Markdown.",
  "author": "SimonSun",
  "license": "MIT",
  "homepage": "https://github.com/Tendo33/journal-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tendo33/journal-md.git"
  },
  "bugs": {
    "url": "https://github.com/Tendo33/journal-md/issues"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:firefox": "webpack --mode production --env target=firefox",
    "dev": "webpack --mode development --watch",
    "verify:dist": "node scripts/verify-dist.js",
    "verify:dist:chrome": "node scripts/verify-dist.js dist --target=chrome",
    "verify:dist:firefox": "node scripts/verify-dist.js dist-firefox --target=firefox",
    "lint": "eslint \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"vendor/**/*.js\" webpack.config.js jest.config.js",
    "test": "jest --runInBand",
    "package": "npm run build && npm run build:firefox && npm run verify:dist:chrome && npm run verify:dist:firefox && node scripts/package.js",
    "check:keys": "node scripts/check-no-keys.js",
    "test:e2e": "npm run build && node scripts/e2e-smoke.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.24.0",
    "archiver": "^7.0.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "pubmed",
    "pmc",
    "europe-pmc",
    "jats",
    "markdown",
    "browser-extension",
    "academic",
    "papers",
    "springer",
    "nature",
    "frontiers",
    "mdpi",
    "plos",
    "elife"
  ],
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  }
}
